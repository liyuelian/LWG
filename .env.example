# ============================================================================
# LWG 灵务阁 · 环境变量模板
#
# 用法：
#   cp .env.example .env     然后把真实密码填进 .env（.env 已在 .gitignore 中）
#
# 说明：
#   - 本文件只放「占位/示例值」，任何真实密码都不允许写进本文件；
#   - 真正的注入发生在部署时：compose 读取同目录的 .env，
#     并由 GitHub Actions 在部署步骤中用仓库 Secrets 覆盖；
#   - 各变量的含义与默认值见 application.yml / application-dev.yml /
#     application-prod.yml 中的 ${...} 占位符。
# ============================================================================

# ---- 数据库 ----
# 生产环境 DB_USERNAME / DB_PASSWORD 没有默认值，不填应用会启动失败（有意为之）
DB_NAME=lwg
DB_USERNAME=root
DB_PASSWORD=change-me

# ---- RabbitMQ ----
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=change-me

# ---- 对外端口 ----
# 前端 nginx 对公网暴露的端口（后端 8080 只绑定 127.0.0.1，不对外）
FRONTEND_PORT=8081

# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=prod
